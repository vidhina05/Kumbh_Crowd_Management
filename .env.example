# Copy to .env.local for local development, or set these in your host's environment settings (e.g. Vercel → Settings → Environment Variables).
# NEVER commit real values. Use different values for development, staging and production.

# ---------- Required ----------
# Postgres connection string. Leave empty locally to use the built-in embedded database (./.data/pglite).
# Production: a hosted Postgres such as Neon, with SSL (…?sslmode=require).
DATABASE_URL=

# 32 random bytes each, base64. Generate with:  openssl rand -base64 32
# DATA_ENCRYPTION_KEY encrypts phone numbers and photos. If you lose it, encrypted data can't be read.
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
LOOKUP_HMAC_KEY=replace-with-openssl-rand-base64-32
SESSION_SECRET=replace-with-openssl-rand-base64-32

# Protects the data-deletion job (/api/cron/retention). Generate with:  openssl rand -hex 24
CRON_SECRET=replace-with-openssl-rand-hex-24

# Hours after a family's bathing slot ends before their personal data is deleted.
RETENTION_HOURS=48

# ---------- Phone verification (SMS) ----------
# none = no SMS is sent. msg91 = MSG91 OTP API (needs a DLT-registered template containing ##OTP##).
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Development/testing only: shows the code on the kiosk screen when SMS isn't connected. The app refuses to start
# in production with this set to true.
OTP_DEV_MODE=false

# ---------- Voice and translation: Bhashini (free, Govt. of India) ----------
# Sign up at https://bhashini.gov.in/ulca → My Profile → generate an API key. Leave empty to turn voice off.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# ---------- Sahayak control-room assistant: Google Gemini ----------
# Create a key at https://aistudio.google.com/apikey . Leave empty to turn Sahayak off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- First deploy only (seed script) ----------
# Creates the first super admin if there are no staff accounts yet. Remove after the first deploy.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Control room admin

# Public address of this deployment, used in SMS links to the pass page (e.g. https://seva.example.org).
APP_URL=

# ---------- Text messages beyond the OTP (MSG91 Flow templates, DLT-registered) ----------
# India requires every SMS to match a pre-registered DLT template, so free text is impossible.
# Leave a template empty and that message is shown as "SMS not connected" instead of being sent.
MSG91_FLOW_PASS=        # "Your pass ##pass## for ##ghat## at ##time##"  (Families → Send pass again)
MSG91_FLOW_DIVERSION=   # "Your ghat changed to ##ghat##, same time ##time##"  (Diversions)
MSG91_FLOW_THANKS=      # "##name## is back with you. Thank you"  (Lost & found)

# ---------- Aadhaar Secure QR ----------
# The UIDAI public certificate (PEM) used to check the signature on the Aadhaar QR code. Get the current one from
# https://uidai.gov.in (offline verification). Without it, Aadhaar scanning is turned off and the kiosk uses phone codes.
AADHAAR_UIDAI_CERT_PEM=
# Demo/training only: offer three invented test cards. Never true on a real deployment.
AADHAAR_ALLOW_TEST_CARDS=false

# ---------- Staff sign-in ----------
# Roles that must use a 6-digit authenticator code (comma-separated). Face sign-in is opt-in per staff member and never
# the only way in: PIN/password + code always works.
MFA_REQUIRED_ROLES=super_admin

# ---------- Crowd sensors ----------
# Training/demo only: generate simulated sensor readings. They are always labelled "Simulated" on screen.
SENSOR_SIMULATOR=false

# ---------- Rate limiting across server instances (recommended in production) ----------
# Upstash Redis REST (free tier is enough). Without it, limits are per server instance, in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set only by the in-browser demo build (GitHub Pages). The server refuses to start with it.
DEMO_MODE=false
