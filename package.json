{
  "name": "kumbh-crowd-management",
  "version": "0.1.0",
  "private": true,
  "description": "Sangam Seva kiosk and Sangam Command admin dashboard for Maha Kumbh crowd management.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node scripts/copy-models.mjs && next dev",
    "build": "node scripts/copy-models.mjs && next build",
    "start": "next start",
    "vercel-build": "node scripts/copy-models.mjs && tsx --conditions=react-server scripts/migrate.ts && tsx --conditions=react-server scripts/seed.ts --no-kiosk && next build",
    "typecheck": "node scripts/gen-demo.mjs && tsc --noEmit",
    "lint:secrets": "node scripts/check-secrets.mjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "build:pages": "node scripts/copy-models.mjs && node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/material-symbols-rounded": "^5.3.9",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-meetei-mayek": "^5.3.0",
    "@fontsource/noto-sans-ol-chiki": "^5.3.0",
    "@fontsource/noto-sans-oriya": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@vladmandic/human": "^3.3.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jsqr": "^1.4.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
